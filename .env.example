# ---------------------------------------------------------------
# Emerg Music - environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are visible in the browser.
# Everything else is server-only and must never reach client code.
# ---------------------------------------------------------------

# --- Supabase (create a free dev project manually; see README) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database for local tests / migrations (local Postgres only) ---
# Example: postgres://postgres@127.0.0.1:54329/emerg_test
DATABASE_URL=

# --- Audio storage ---
# "local" (default, $0, dev only) or "r2" (Cloudflare R2: approved by the owner, see docs/COST_AND_DEPLOYMENT.md)
STORAGE_DRIVER=local
# Directory for the local driver (ignored by git)
LOCAL_STORAGE_DIR=./storage-local
# Secret used to sign short-lived upload/playback tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIA_SIGNING_SECRET=
# Token lifetimes in seconds
UPLOAD_TOKEN_TTL_SECONDS=600
PLAYBACK_TOKEN_TTL_SECONDS=300
# Max original upload size in bytes (default 100 MB)
MAX_UPLOAD_BYTES=104857600

# --- Cloudflare R2 (SERVER-ONLY; never prefix with NEXT_PUBLIC_, never commit) ---
# Two separate PRIVATE buckets (public access / r2.dev URL disabled, no custom domain), and ONE API token scoped to exactly
# those two buckets with "Object Read & Write". Verify with: npm run r2:smoke
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ORIGINALS=
R2_BUCKET_RENDITIONS=

# --- Worker ---
# "local-ffmpeg" (default). A hosted worker can replace it later.
WORKER_DRIVER=local-ffmpeg
FFMPEG_PATH=ffmpeg

# --- Local preview only ---
# "sample" shows clearly labelled FICTIONAL catalog data without a backend (banner always visible).
# Refused when NODE_ENV=production unless ALLOW_SAMPLE_CATALOG=1 is also set. Leave unset for real data.
CATALOG_SOURCE=
ALLOW_SAMPLE_CATALOG=
