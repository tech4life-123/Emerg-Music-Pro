{
  "name": "emerg-music-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Emerg Music - Liberia-first music streaming platform (Phase 1 foundation)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "r2:smoke": "tsx --conditions=react-server scripts/r2-smoke.ts",
    "local-stack": "tsx --conditions=react-server scripts/local-stack.ts",
    "fixtures:generate": "tsx scripts/generate-sample-audio.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/lib-storage": "3.1155.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
